//dsh-aardio bridge —— 在 aardio IDE 里按 F5 启动，关掉窗口即停止。
//
//它做三件事：
//   1. 编译检查：loadcode 编译代码，编译错误带行号；支持内存替换（codeReplacement）；
//   2. 执行代码：在独立线程里运行，捕获 print 输出、return 返回值与运行时错误；
//   3. 把结果写成 JSON，交给 DSH 侧的 aardio_exec 工具。
//
//窗口用 WebView2 渲染，配色取自 DSH 深色主题（bg rgb(21,21,23)、卡片 rgb(35,35,36)、
//描边 rgba(255,255,255,.08)），并把「当前在干什么」实时显示出来：状态、作业、代码、
//print 流、编译/失败事件。WebView2 不可用时自动退回纯文本窗口。
//
//为什么必须在 IDE 里跑：载入代码的 loadcode/loadcodex 只存在于 aardio 进程内，
//aardio.exe 也没有无头命令行入口。执行方式参照 aardio 自带 autos 的
//executeCodeSync（lib\autos\tools\handlers.aardio）。
//
//关于「超时」：aardio 没有安全的线程终止手段（TerminateThread 会破坏运行时），
//所以这里不让 UI 线程死等，而是：
//   - 请求开始后最多等 REPLY_WAIT_MS 就回 pending（带 jobId），作业继续跑；
//   - 之后每次 poll 请求再等 REPLY_WAIT_MS；
//   - 结果留在内存里，直到被取走或超过 JOB_KEEP_MS。
//
//不要尝试把它发布成 EXE：它依赖 IDE 进程内的 loadcode。

import win.ui;
import win;
import io;
import JSON;
import thread;

var dir = io.fullpath(string.getenv("TEMP") ++ "\dsh-aardio-bridge\");
io.createDir(dir);

var infoPath = dir ++ "bridge.json";
var requestPath = dir ++ "request.json";
var responsePath = dir ++ "response.json";

//每次请求最多占用 UI 线程的时间；到点就回 pending，作业在后台继续。
var REPLY_WAIT_MS = 8000;

//已完成但还没被取走的结果保留多久。
var JOB_KEEP_MS = 300000;

//一次性 token：DSH 侧从 bridge.json 读取，双方都校验，避免误读其它请求。
var token = string.format("%08x%08x", math.random(0x7FFFFFFF), time.tick());
var startedAt = time.tick();

//页面：DSH 深色配色 + 活动流。注意这是原样字符串，里面不能出现反引号。
var PAGE = `<!DOCTYPE html>
<html lang="zh"><head><meta charset="utf-8"><style>
:root{
  --bg: rgb(21,21,23); --l1: rgb(35,35,36); --l2: rgb(44,44,46); --l3: rgb(53,54,56);
  --fg: rgb(249,250,251); --fg2: rgb(207,211,214); --fg3: rgb(173,178,184);
  --border: rgba(255,255,255,.08); --border2: rgba(255,255,255,.14);
  --ok: rgb(34,197,94); --err: rgb(242,90,90); --warn: rgb(234,179,8);
  --radius: 10px;
}
*{box-sizing:border-box}
html,body{height:100%;overflow:hidden}
body{margin:0;background:var(--bg);color:var(--fg);
  font:13px/1.55 -apple-system,"Segoe UI","Microsoft YaHei",sans-serif;
  display:flex;flex-direction:column;overflow:hidden;user-select:none;height:100vh}
header{display:flex;align-items:center;gap:10px;padding:16px 20px 10px;flex:none}
.dot{width:8px;height:8px;border-radius:50%;background:var(--fg3);flex:none}
.dot.running{background:var(--ok);box-shadow:0 0 0 4px rgba(34,197,94,.16)}
h1{font-size:14px;font-weight:600;margin:0;letter-spacing:.2px}
.sub{color:var(--fg3);font-size:12px;margin-top:1px}
.spacer{flex:1}
.pill{font:11px ui-monospace,Consolas,monospace;color:var(--fg2);
  border:1px solid var(--border);border-radius:999px;padding:2px 9px}
main{padding:0 20px 14px;display:flex;flex-direction:column;gap:12px;flex:1;min-height:0;overflow:hidden}
.card{background:var(--l1);border:1px solid var(--border);border-radius:var(--radius);padding:13px 15px}
.row{display:flex;align-items:baseline;gap:10px;flex:none}
.status{font-size:15px;font-weight:600}
.elapsed{font:12px ui-monospace,Consolas,monospace;color:var(--fg2)}
.meta{display:flex;gap:16px;color:var(--fg3);font-size:12px;margin-top:5px;flex-wrap:wrap}
pre.code{margin:9px 0 0;background:var(--l2);border:1px solid var(--border);border-radius:8px;
  padding:10px 12px;max-height:118px;overflow:auto;color:var(--fg2);
  font:12px/1.5 ui-monospace,Consolas,monospace;white-space:pre-wrap;user-select:text}
.logCard{flex:1;min-height:0;display:flex;flex-direction:column}
.logHead{display:flex;align-items:center;justify-content:space-between;margin-bottom:8px}
.logHead strong{font-size:12px;font-weight:600;color:var(--fg2)}
.log{overflow:auto;flex:1;display:flex;flex-direction:column;gap:5px;
  font:12px/1.5 ui-monospace,Consolas,monospace;user-select:text}
.entry{display:flex;gap:12px;color:var(--fg2)}
.entry .t{color:var(--fg3);flex:none}
.entry.print{color:var(--fg)}
.entry.ok{color:var(--ok)}
.entry.error{color:var(--err)}
.entry.warn{color:var(--warn)}
footer{padding:0 20px 14px;color:var(--fg3);font-size:11px;display:flex;gap:14px;justify-content:space-between}
button{font:11px inherit;color:var(--fg);background:var(--l2);border:1px solid var(--border2);
  border-radius:999px;padding:3px 10px;cursor:pointer;user-select:none}
button:hover{background:var(--l3)}
.winbtn{width:30px;height:24px;display:flex;align-items:center;justify-content:center;
  border:none;background:transparent;color:var(--fg2);border-radius:6px;
  font:12px/1 "Segoe UI",sans-serif;cursor:pointer;user-select:none;padding:0}
.winbtn:hover{background:rgba(255,255,255,.10);color:var(--fg)}
.winbtn.close:hover{background:rgba(242,90,90,.22);color:#fff}
::-webkit-scrollbar{width:10px;height:10px}
::-webkit-scrollbar-track{background:transparent}
::-webkit-scrollbar-thumb{background:rgba(255,255,255,.14);border-radius:8px;
  border:2px solid transparent;background-clip:content-box}
::-webkit-scrollbar-thumb:hover{background:rgba(255,255,255,.26);background-clip:content-box}
::-webkit-scrollbar-corner{background:transparent}
</style></head>
<body>
<header id="titlebar">
  <span class="dot" id="dot"></span>
  <div><h1>dsh-aardio bridge</h1><div class="sub" id="sub">等待 DSH 的 aardio_exec 请求</div></div>
  <div class="spacer"></div>
  <span class="pill" id="pid">pid —</span>
  <button class="winbtn" type="button" data-win="min" title="最小化" aria-label="最小化">&#8211;</button>
  <button class="winbtn" type="button" data-win="max" title="最大化" aria-label="最大化">&#9744;</button>
  <button class="winbtn close" type="button" data-win="close" title="关闭" aria-label="关闭">&#10005;</button>
</header>
<main>
  <section class="card">
    <div class="row"><span class="status" id="status">空闲</span><span class="elapsed" id="elapsed"></span></div>
    <div class="meta"><span id="job">无作业</span><span id="source">—</span><span id="mode">—</span></div>
    <pre class="code" id="code">（还没有请求）</pre>
  </section>
  <section class="card logCard">
    <div class="logHead"><strong>活动</strong><button onclick="clearLog()">清空</button></div>
    <div class="log" id="log"></div>
  </section>
</main>
<footer><span>关掉这个窗口即停止桥接</span><span id="dir"></span></footer>
<script>
(function(){
  var state = {status:'idle', elapsedMs:0};
  var startedAt = 0;
  var dot = document.getElementById('dot');
  var statusEl = document.getElementById('status');
  var elapsedEl = document.getElementById('elapsed');
  var jobEl = document.getElementById('job');
  var sourceEl = document.getElementById('source');
  var modeEl = document.getElementById('mode');
  var codeEl = document.getElementById('code');
  var logEl = document.getElementById('log');
  var pidEl = document.getElementById('pid');
  var dirEl = document.getElementById('dir');
  var subEl = document.getElementById('sub');

  function fmt(ms){
    var s = ms / 1000;
    return s < 10 ? s.toFixed(1) + 's' : Math.round(s) + 's';
  }
  function tick(){
    if (state.status === 'running' && startedAt) {
      elapsedEl.textContent = fmt(Date.now() - startedAt);
    } else {
      elapsedEl.textContent = '';
    }
  }
  window.setHeader = function(pid, dir){
    pidEl.textContent = 'pid ' + pid;
    dirEl.textContent = dir;
  };
  window.applyState = function(s){
    state = s || {status:'idle'};
    if (state.status === 'running') {
      startedAt = Date.now() - (state.elapsedMs || 0);
      subEl.textContent = '正在 IDE 里运行 DSH 提交的代码';
    } else if (state.status === 'compiling') {
      startedAt = 0;
      subEl.textContent = '正在编译 DSH 提交的代码';
    } else {
      startedAt = 0;
      subEl.textContent = '等待 DSH 的 aardio_exec 请求';
    }
    dot.className = 'dot' + (state.status === 'running' ? ' running' : '');
    statusEl.textContent = state.status === 'running' ? '运行中'
      : (state.status === 'compiling' ? '编译中' : '空闲');
    jobEl.textContent = state.jobId ? ('job ' + state.jobId) : '无作业';
    sourceEl.textContent = state.source ? ('来源 ' + state.source) : '—';
    modeEl.textContent = state.mode ? ('模式 ' + state.mode) : '—';
    if (typeof state.code === 'string') codeEl.textContent = state.code || '（空）';
    tick();
  };
  window.addLogs = function(list){
    var auto = logEl.scrollTop + logEl.clientHeight >= logEl.scrollHeight - 30;
    for (var i = 0; i < list.length; i++) {
      var row = document.createElement('div');
      row.className = 'entry ' + (list[i].kind || '');
      var at = document.createElement('span');
      at.className = 't';
      at.textContent = list[i].at;
      var text = document.createElement('span');
      text.textContent = list[i].text;
      row.appendChild(at);
      row.appendChild(text);
      logEl.appendChild(row);
    }
    while (logEl.children.length > 400) logEl.removeChild(logEl.firstChild);
    if (auto) logEl.scrollTop = logEl.scrollHeight;
  };
  window.clearLog = function(){ logEl.innerHTML = ''; };

  //自定义标题栏：拖动、双击最大化、三个按钮都交给 aardio 处理。
  //注意：web.view 占用了 window.external，导出的对象是 window.aardio。
  //不要用 typeof 判断宿主方法（COM 代理下不可靠），直接调用并捕获异常。
  function callHost(name){
    try {
      if (window.aardio) {
        window.aardio[name]();
        return true;
      }
    } catch (e) {}
    return false;
  }

  var bar = document.getElementById('titlebar');
  bar.addEventListener('mousedown', function(e){
    if (e.button !== 0 || e.target.closest('button')) return;
    callHost('drag');
  });
  bar.addEventListener('dblclick', function(e){
    if (e.target.closest('button')) return;
    callHost('maximize');
  });
  var buttons = bar.querySelectorAll('button[data-win]');
  for (var i = 0; i < buttons.length; i++) {
    buttons[i].addEventListener('click', function(){
      var action = this.getAttribute('data-win');
      if (action === 'min') callHost('minimize');
      else if (action === 'max') callHost('maximize');
      else callHost('close');
    });
  }

  setInterval(tick, 200);
})();
</script>
</body></html>`;

//无边框窗口：标题栏由 WebView 页面提供；WebView2 不可用时用 simpleWindow 补一个原生标题栏。
var winform = win.form(text="dsh-aardio bridge"; right=760; bottom=580; bgcolor=0x171515; border="none");
winform.add(
	fallback={cls="static";text="桥接已启动。等待 DSH 的 aardio_exec 请求…";left=24;top=48;right=736;bottom=520;transparent=1;color=0xECE8E6;font=LOGFONT(h=-13);z=1};
	fallbackTip={cls="static";text="关掉这个窗口即停止桥接（不会影响 IDE 里其它脚本）。";left=24;top=528;right=736;bottom=552;transparent=1;color=0xB8B2AD;font=LOGFONT(h=-12);z=2}
);

//WebView2 不可用时（缺少运行时）退回纯文本窗口，桥接功能不受影响。
var wb;
var webError = "";
var htmlError = "";
var pageReady = false;
var externalOk = false;
var shadowOk = false;
var roundOk = false;
var webStatePath = dir ++ "web-state.json";

var saveWebState = function() {
	JSON.save(webStatePath, {
		created = (wb !== null);
		ready = pageReady;
		createError = webError;
		htmlError = htmlError;
		externalOk = externalOk;
		shadowOk = shadowOk;
		roundOk = roundOk;
	});
};

var callOk, callErr = call(function() {
	import web.view;
	wb = web.view(winform);
});
if (callOk !== true) {
	webError = "web.view 创建失败：" ++ tostring(callErr);
	wb = null;
} elseif (!wb) {
	webError = "web.view(winform) 返回空值";
}
saveWebState();

//有 WebView 时：无边框 + 阴影/可拖拽边框，标题栏由页面实现；
//没有 WebView 时：用 simpleWindow 补一个原生标题栏，至少还能拖动和关闭。
if (wb) {
	externalOk = call(function() {
		wb.external = {
			drag = function() {
				winform.hitCaption();
			};
			minimize = function() {
				winform.hitMin();
			};
			maximize = function() {
				winform.hitMax();
			};
			close = function() {
				winform.hitClose();
			};
		};
	}) === true;

	shadowOk = call(function() {
		import win.ui.shadow;
		win.ui.shadow(winform);
	}) === true;

	//圆角窗口 + 最小尺寸（round 内部会调用 win.ui.minmax）。
	roundOk = call(function() {
		import win.region.round;
		win.region.round(winform, 660, 500, 12);
	}) === true;
} else {
	call(function() {
		import win.ui.simpleWindow;
		win.ui.simpleWindow(winform);
	});
	call(function() {
		import win.ui.minmax;
		win.ui.minmax(winform, 660, 500);
	});
}

saveWebState();

//页面可能要在窗口显示、WebView2 初始化完成之后才能设置，失败就下次定时器再试。
var loadPage = function() {
	if (!wb || pageReady) {
		return;
	}
	var ok, err = call(function() {
		wb.html = PAGE;
	});
	if (ok === true) {
		pageReady = true;
		htmlError = "";
	} else {
		htmlError = tostring(err);
	}
	saveWebState();
};

var ui = function(expression) {
	if (!wb || !pageReady) {
		return;
	}
	call(function() {
		wb.invoke(expression);
	});
};

var logs = function(list) {
	var entries = {};
	var at = time.now().format("%H:%M:%S");
	for (i = 1; #list) {
		table.push(entries, {
			at = at;
			kind = list[i].kind;
			text = string.left(tostring(list[i].text), 400);
		});
	}
	ui("addLogs(" ++ JSON.stringify(entries) ++ ")");
};

var applyState = function(state) {
	ui("applyState(" ++ JSON.stringify(state) ++ ")");
};

//纯文本回退窗口里的状态行。
var fallbackText = function(text) {
	if (!wb || !pageReady) {
		winform.fallback.text = text;
	}
};

var codePreview = function(code) {
	var lines = string.split(code, '\n');
	var total = #lines;
	var text = "";
	for (i = 1; total) {
		if (i > 14) {
			break;
		}
		text ++= lines[i] ++ '\n';
	}
	if (#text > 2000) {
		text = string.left(text, 2000) ++ "…";
	}
	if (total > 14) {
		text = text ++ "… 共 " ++ total ++ " 行";
	}
	return text;
};

//当前作业：{ key; outKey; handle; nonce; deadline; startedAt; result; finishedAt; printed }
var job = null;

var cleanJob = function() {
	if (!job) {
		return;
	}
	if (job.key) {
		thread.set(job.key, null);
	}
	if (job.outKey) {
		thread.set(job.outKey ++ "#n", null);
	}
	if (job.handle) {
		raw.closeHandle(job.handle);
	}
	job = null;
};

var respond = function(nonce, payload) {
	payload.nonce = nonce;
	payload.token = token;
	JSON.save(responsePath, payload);
};

var emptyResult = function(phase, ok) {
	return {
		ok = ok;
		phase = phase;
		compileError = "";
		error = "";
		result = "";
		resultType = "";
		print = {};
		durationMs = 0;
	};
};

//按顺序应用内存替换；每一处都必须恰好命中一次。
var applyReplacements = function(code, list) {
	if (!list) {
		return code;
	}
	if (type(list) != "table") {
		return null, "replacements 必须是数组";
	}
	if (!#list) {
		return code;
	}

	code = string.crlf(code);
	for (i = 1; #list) {
		var item = list[i];
		if (type(item) != "table") {
			return null, "第 " ++ i ++ " 处替换不是对象";
		}
		var old = item.old;
		var new = item.new;
		if (type(old) != "string") {
			return null, "第 " ++ i ++ " 处替换缺少 oldCode";
		}
		if (!#old) {
			return null, "第 " ++ i ++ " 处替换的 oldCode 为空";
		}
		if (type(new) != "string") {
			new = "";
		}

		var count;
		code, count = string.replaceLiteral(code, string.crlf(old), string.crlf(new));
		if (count !== 1) {
			return null, "第 " ++ i ++ " 处替换命中了 " ++ count ++ " 次，必须恰好命中一次";
		}
	}

	return code;
};

var requestSummary = function(request) {
	var source = request.source ? request.source : "inline";
	return tostring(request.mode) ++ " · " ++ source;
};

//启动一个后台作业；compile / check 直接返回。
var startJob = function(request) {
	var nonce = request.nonce;
	var summary = requestSummary(request);

	logs({
		{kind = "request"; text = "收到请求（" ++ summary ++ "）"};
	});

	var code, replaceErr = applyReplacements(request.code, request.replacements);
	if (!code) {
		var failed = emptyResult("compile", false);
		failed.compileError = tostring(replaceErr);
		respond(nonce, failed);
		logs({ {kind = "error"; text = "内存替换失败：" ++ tostring(replaceErr)} });
		applyState({status = "idle"; source = summary});
		return;
	}

	if (request.replacements) {
		logs({ {kind = "warn"; text = "已应用 1 处内存替换（源文件未改动）"} });
	}

	//不覆盖 win.loopMessage（实测不生效），但至少在界面上提醒：这行会让作业一直等窗口关闭。
	if (string.indexOf(code, "win.loopMessage") !== null) {
		logs({ {kind = "warn"; text = "代码里调用了 win.loopMessage()：窗口不关闭就会一直运行；GUI 冒烟建议用 replace 替换它"} });
	}

	applyState({
		status = "compiling";
		source = summary;
		mode = tostring(request.mode);
		code = codePreview(code);
	});

	var checkFunc, err = loadcode(code);
	if (!checkFunc) {
		var compile = emptyResult("compile", false);
		compile.compileError = tostring(err);
		respond(nonce, compile);
		logs({ {kind = "error"; text = "编译失败：" ++ string.left(tostring(err), 300)} });
		applyState({status = "idle"; source = summary; mode = tostring(request.mode); code = codePreview(code)});
		fallbackText("编译失败：" ++ tostring(err));
		return;
	}

	logs({ {kind = "ok"; text = "编译通过"} });

	if (request.mode == "check") {
		respond(nonce, emptyResult("check", true));
		logs({ {kind = "ok"; text = "check 模式：不执行"} });
		applyState({status = "idle"; source = summary; mode = "check"; code = codePreview(code)});
		fallbackText("已就绪，等待下一个请求…");
		return;
	}

	var key = "(dsh-aardio:job:" ++ nonce ++ ")";
	var outKey = "(dsh-aardio:out:" ++ nonce ++ ")";
	thread.set(key, null);
	thread.set(outKey ++ "#n", null);

	//代码在线程内编译：loadcode 会把函数的全局作用域绑到调用它的线程，
	//这样下面的 print / win.loopMessage 覆盖才会对它生效。
	var handle = thread.create(
		function(code, key, outKey) {
			import JSON;
			import win;

			_CONSOLE_NO_PAUSE = true;

			var output = {};
			..print = function(...) {
				if (#output >= 200) {
					return;
				}
				var args = [...];
				var line = "";
				for (i = 1; #args) {
					line ++= tostring(args[i]);
				}
				..table.push(output, line);
				..thread.set(outKey ++ "#" ++ #output, line);
				..thread.set(outKey ++ "#n", #output);
			};

			//注意：不要试图覆盖 win.loopMessage 来兜底——用户代码 import win 后拿到的是
			//自己的模块实例，实测覆盖不生效。GUI 冒烟请用 replace 把 win.loopMessage(); 换掉。
			var func, compileErr = loadcode(code);
			if (!func) {
				..thread.set(key, {
					ok = false;
					value = "";
					valueType = "null";
					error = "线程内编译失败：" ++ tostring(compileErr);
					print = output;
				});
				return;
			}

			var ok, value, valueErr = call(func);

			var text = "";
			var textType = "null";
			var errorText = "";

			if (ok) {
				var okJson, json = call(function(v) {
					return ..JSON.stringify(v);
				}, null, value);

				if (okJson) {
					text = json;
				} else {
					text = tostring(value);
				}
				textType = tostring(type(value));
			} else {
				// call() 在失败时把错误放在第一个返回值里，第 2 个返回值通常为空。
				var message;
				if (value) {
					message = value;
				} else {
					message = valueErr;
				}
				errorText = tostring(message);
			}

			if (#text > 200000) {
				text = ..string.left(text, 200000) ++ "…[已截断]";
			}

			..thread.set(key, {
				ok = ok;
				value = text;
				valueType = textType;
				error = errorText;
				print = output;
			});
		}, code, key, outKey);

	if (!handle) {
		var startFailed = emptyResult("run", false);
		startFailed.error = "无法创建执行线程";
		respond(nonce, startFailed);
		logs({ {kind = "error"; text = "无法创建执行线程"} });
		applyState({status = "idle"; source = summary; code = codePreview(code)});
		return;
	}

	job = {
		key = key;
		outKey = outKey;
		handle = handle;
		nonce = nonce;
		deadline = time.tick() + REPLY_WAIT_MS;
		startedAt = time.tick();
		result = null;
		finishedAt = null;
		printed = 0;
		source = summary;
		mode = tostring(request.mode);
		code = codePreview(code);
	};

	logs({ {kind = "run"; text = "开始执行（" ++ summary ++ "）"} });
	applyState({
		status = "running";
		source = summary;
		mode = tostring(request.mode);
		jobId = string.right(key, 8);
		code = codePreview(code);
	});
	fallbackText("运行中… 关掉窗口即停止。");
};

var jobPayload = function(result, elapsed) {
	var payload = emptyResult("run", result.ok === true);
	payload.error = result.error;
	payload.result = result.value;
	payload.resultType = result.valueType;
	payload.print = result.print;
	payload.durationMs = elapsed;
	return payload;
};

//把工作线程已经产生的 print 行搬进活动流。
var flushPrint = function() {
	if (!job || !job.outKey) {
		return;
	}
	var count = thread.get(job.outKey ++ "#n");
	if (!count) {
		return;
	}
	if (count <= job.printed) {
		return;
	}
	var fresh = {};
	for (i = job.printed + 1; count) {
		var line = thread.get(job.outKey ++ "#" ++ i);
		table.push(fresh, {kind = "print"; text = "  " ++ tostring(line)});
	}
	job.printed = count;
	logs(fresh);
};

var poll = function() {
	//一次只接受一个作业；有作业时只处理与它相关的 poll。
	if (io.exists(requestPath)) {
		var raw = string.load(requestPath);
		io.remove(requestPath);
		if (raw) {
			var request = JSON.tryParse(raw);
			if (request && request.token === token) {
				var action = request.action;
				if (action == "poll") {
					if (job) {
						if (request.jobId == job.key) {
							job.nonce = request.nonce;
							job.deadline = time.tick() + REPLY_WAIT_MS;
							logs({ {kind = "warn"; text = "DSH 继续轮询（作业仍在跑）"} });
						} else {
							var other = emptyResult("run", false);
							other.error = "当前作业不是 " ++ tostring(request.jobId);
							respond(request.nonce, other);
						}
					} else {
						var gone = emptyResult("run", false);
						gone.error = "没有正在运行或可取的作业，请重新提交代码";
						respond(request.nonce, gone);
					}
				} elseif (job) {
					var busy = emptyResult("run", false);
					busy.pending = true;
					busy.busy = true;
					busy.jobId = job.key;
					busy.error = "桥接正忙，请用 aardio_exec({jobId}) 继续等待";
					respond(request.nonce, busy);
					logs({ {kind = "warn"; text = "收到新请求，但桥接正忙"} });
				} elseif (!request.code) {
					var missing = emptyResult("run", false);
					missing.error = "请求缺少 code";
					respond(request.nonce, missing);
				} else {
					startJob(request);
				}
			}
		}
	}

	if (!job) {
		return;
	}

	flushPrint();

	if (!job.result) {
		job.result = thread.get(job.key);
		if (job.result) {
			job.finishedAt = time.tick();
		}
	}

	if (job.result) {
		//结果没被取走就保留一段时间，方便 DSH 侧超时后继续轮询。
		if (job.nonce) {
			var elapsed = job.finishedAt - job.startedAt;
			flushPrint();
			respond(job.nonce, jobPayload(job.result, elapsed));
			var kind = "ok";
			var text = "完成（" ++ elapsed ++ " ms）";
			if (!job.result.ok) {
				kind = "error";
				text = "运行失败（" ++ elapsed ++ " ms）";
			}
			if (job.result.ok && job.result.valueType == "table") {
				text = text ++ " · 返回 table";
			}
			logs({ {kind = kind; text = text} });
			applyState({
				status = "idle";
				source = job.source;
				mode = job.mode;
				code = job.code;
			});
			fallbackText("已就绪，等待下一个请求…");
			cleanJob();
		} elseif (time.tick() - job.finishedAt > JOB_KEEP_MS) {
			logs({ {kind = "warn"; text = "上一次结果长时间无人取走，已丢弃"} });
			cleanJob();
		}
		return;
	}

	if (job.nonce && time.tick() >= job.deadline) {
		var pending = emptyResult("run", false);
		pending.pending = true;
		pending.jobId = job.key;
		pending.durationMs = time.tick() - job.startedAt;
		respond(job.nonce, pending);
		job.nonce = null;
		logs({ {kind = "warn"; text = "超过 " ++ (REPLY_WAIT_MS / 1000) ++ " 秒仍未结束，回 pending；作业继续运行"} });
	}
};

JSON.save(infoPath, {
	version = 1;
	token = token;
	pid = ::Kernel32.GetCurrentProcessId();
	startedAt = startedAt;
	dir = dir;
	hwnd = winform.hwnd;
	web = {created = (wb !== null); ready = pageReady; error = webError};
});

//页面就绪后才写页面内容；未就绪时用纯文本窗口说明原因。
var initUi = function() {
	if (!wb || !pageReady) {
		var reason = webError;
		if (reason === "" && htmlError !== "") {
			reason = "页面加载失败：" ++ htmlError;
		}
		if (reason === "") {
			reason = "WebView2 尚未就绪";
		}
		fallbackText("桥接已启动，但 WebView2 界面不可用，退回文本窗口。"
			++ '\r\n' ++ "原因：" ++ string.left(reason, 300)
			++ '\r\n' ++ "请求目录：" ++ dir
			++ '\r\n' ++ "桥接功能正常，DSH 仍可调用 aardio_exec。");
		return;
	}

	ui("setHeader(" ++ JSON.stringify(::Kernel32.GetCurrentProcessId()) ++ "," ++ JSON.stringify(dir) ++ ")");
	ui('applyState({status:"idle"})');
	logs({
		{kind = "ok"; text = "桥接已启动，等待 DSH 的 aardio_exec 请求"};
		{kind = "print"; text = "请求目录：" ++ dir};
	});
};

winform.show();
loadPage();

//页面在窗口显示后才可能初始化完成；定时器里重试并补一次初始化。
if (wb && !pageReady) {
	winform.setTimeout(function() {
		loadPage();
		if (pageReady) {
			initUi();
		}
	}, 500);
}
initUi();

winform.setInterval(function() {
	if (wb && !pageReady) {
		loadPage();
		if (pageReady) {
			initUi();
		}
	}
	poll();
}, 150);
win.loopMessage();

cleanJob();
io.remove(infoPath);
io.remove(requestPath);
io.remove(responsePath);
io.remove(webStatePath);
