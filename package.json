{
  "name": "dsh-aardio",
  "version": "1.0.1",
  "description": "aardio toolchain for DeepSeek Harness: bundled writing skills, a keyword search engine over your installation, open-in-IDE, and a settings page for the aardio folder.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "aardio",
    "agent-skill"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MFn233/dsh-aardio.git"
  },
  "homepage": "https://github.com/MFn233/dsh-aardio#readme",
  "bugs": {
    "url": "https://github.com/MFn233/dsh-aardio/issues"
  },
  "type": "module",
  "main": "index.js",
  "icon": "./icon.svg",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "lib",
    "bridge",
    "skills",
    "locale/*.json",
    "docs",
    "icon.svg",
    "README.md",
    "README.zh.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test",
    "check": "node --check client.js && node --check index.js",
    "pack:check": "npm pack --dry-run"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "peerDependencies": {
    "@deepseek-ai/schemastery": ">=3.18.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT"
}
